rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App novo: cada usuário só lê e grava os próprios registros.
    match /usuarios/{uid}/registros/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // App antigo: SOMENTE LEITURA, para a migração.
    // Troque SEU_EMAIL_AQUI pelo e-mail da conta Google que você usa no app.
    // (O app antigo usa credencial de administrador e não é afetado por estas regras.)
    match /processos/{id} {
      allow read: if request.auth != null && request.auth.token.email == "SEU_EMAIL_AQUI";
    }
  }
}
