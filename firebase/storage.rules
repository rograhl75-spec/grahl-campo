rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos do app novo
    match /usuarios/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && (request.resource == null || request.resource.size < 40 * 1024 * 1024);
    }

    // Fotos do app antigo: SOMENTE LEITURA, para a migração
    match /campo_fotos/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email == "SEU_EMAIL_AQUI";
    }
  }
}
