rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mesma lista de contas de firebase/firestore.rules: troque SEU_EMAIL_AQUI.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["SEU_EMAIL_AQUI"];
    }
    function dono(uid) { return autorizado() && request.auth.uid == uid; }

    // Fotos: só JPEG (o app converte tudo para JPEG antes de enviar), até 15 MB
    match /usuarios/{uid}/fotos/{arquivo} {
      allow read: if dono(uid);
      allow create, update: if dono(uid)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if false;
    }

    // Anexos (autos, laudos antigos, relatórios de medição, anotações): até 40 MB.
    // Acima disso o app guarda o arquivo só no aparelho (e no backup ZIP).
    match /usuarios/{uid}/anexos/{arquivo} {
      allow read: if dono(uid);
      allow create, update: if dono(uid)
        && request.resource.size < 40 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('text/.*')
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
            || request.resource.contentType == 'application/octet-stream');
      allow delete: if false;
    }

    // Fotos do app antigo: SOMENTE LEITURA, para a migração
    match /campo_fotos/{allPaths=**} {
      allow read: if autorizado();
    }

    // Todo o resto fica fechado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
